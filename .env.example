NODE_ENV=development
PORT=5000

# MongoDB Atlas: Database > Connect > Drivers (add /sri_ganesh_dev before the ?)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sri_ganesh_dev?retryWrites=true&w=majority

# Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_64_char_hex
JWT_REFRESH_SECRET=replace_with_different_random_64_char_hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Dev seed only (never used in production)
SEED_ADMIN_NAME=CEO
SEED_ADMIN_EMAIL=ceo@example.com
SEED_ADMIN_PASSWORD=choose_a_strong_password

# Phase 5 (Cloudinary), leave blank for now
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=